# Supabase project (public browser credentials — protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional legacy endpoint for the contact form when Supabase is not configured
VITE_INQUIRY_ENDPOINT=

# Never put the Supabase service-role key or any third-party provider
# credentials (email / WhatsApp / SMS) in this file. Configure those as
# Supabase secrets for Edge Functions / Database Webhooks instead.
